  "item": 337,
  "proof_object": {
    "actual_family_implication": "An Item-316 target supplies a canonical digit word and the exact cofactors z_j=epsilon(delta_j-w_j delta_(j-1)); Item 335 proves that at least one z_j is nonzero.",
    "canonical_witness": "Set delta_1=3, delta_j=1 at even j and w_j/2 at odd j; when m is odd lower delta_m by one. This is canonical and lies strictly between a/(2c) and a/2.",
    "capacity_decision": "The canonical intermediate-window class admits log Lambda>=(1/2+o(1))log b. Hence fixed-complexity closure does not extend to the full tower; Lambda is a bulk invariant.",
    "external_published_input": {
      "author": "Javier Cilleruelo",
      "reproved_by_replay": false,
      "theorem": "For irreducible quadratic f in Z[x], log lcm(f(1),...,f(N))=N log N+O_f(N).",
      "title": "The least common multiple of a quadratic sequence",
      "url": "https://arxiv.org/abs/1001.3438"
    },
    "one_target_ceiling": "For every de-overlapped Q|b, gcd(Q,Lambda)|Q, so the tower can supply at most log Q<=log b, never two target copies.",
    "primitive_tower": "Lambda=lcm_{z_j nonzero}|z_j|. For Q|b, log gcd(Q,Lambda) equals sum_p min(v_p(Q),max_j v_p(z_j)) log p.",
    "quadratic_subsequence": "For every even j=2r>=4, |z_j|=32r^2-3, whose discriminant 384 is nonsquare; gcd(|f(0)|,|f(1)|)=gcd(3,29)=1.",
    "strict_scope": "The witness is not asserted to satisfy Item 316's small-error or Delta=0 target equation. Actual target overlap with Q remains open and no capacity is booked.",
    "universal_upper": "Lambda<=product_{j=3}^m w_j w_(j-1)=W_m^2/(w_1^2 w_2 w_m), while W_m<=a<exp(1/8)W_m; therefore log Lambda<=2 log b-3 log A+O(1)."
  },
