  "all_parameter_theorem": {
    "asymptotic": "For fixed correction data and ord_0(h)>=(1/2+eps)deg(h), the forced denominator has log at least eps*deg(h)+o(deg(h)).",
    "forced_prefix": "For j<ord_0(h), r=(h-1)/u has r_2k=(-1)^(k+1) and r_(2k+1)=0.",
    "norm_scope": "A fixed nonzero K retains its first endpoint jet, so its weighted L1 correction norm is only polynomially small; denominator times absolute norm diverges in this regime.",
    "prime_window": "If p>(deg(S)+1)/2, p-1>deg(G), p<ord_0(h), and p does not divide alpha, then v_p(4*integral(S))=-1.",
    "quotient": "S=(h-1)G+((h-1)/u)(alpha+beta*x)+(1-x)(h'/u)K"
  },
