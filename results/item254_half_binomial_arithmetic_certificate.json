  "schema": "item254-half-binomial-arithmetic-certificate-v1",
  "theorems": {
    "Greene_split": "H_m=-T_p+epsilon_2*J_p, where T_p is the three-point Teichmuller/Greene sum and J_p=n-m+1 is a p-unit modulo p",
    "Mellin_period": "H_m=-sum_(x in F_p^*) x^(-m) C_p(x), with (x^(-m))^6=x^(2r+8)",
    "fixed_cutoff": "H_m=H_floor(p/6)-h_floor(p/6)*B_delta mod p, with a fixed-length rational B_delta for fixed r",
    "incomplete_beta": "H_m=2^(-m)(2m+d)binom(3m+d,m) integral_0^1 u^(2m+d-1)(1-2u)^m du mod p, d=r+4",
    "prefix_polynomial": "(1-z)C_p(z)=(1-z/2)^((p-1)/2)-epsilon_2*z^((p+1)/2), C_p(z)=sum_(k=0)^((p-1)/2) H_k z^k, C_p(1)=0",
    "residue_phase_localization": "for p=1 mod 6, x^(-m)=x^delta*rho^(-1)(x) with rho sextic; for p=5 mod 6, cube substitution localizes T_p to a punctured rational moment on y^2=x(1-x^3/2)",
    "weighted_zero_container": "sum_(p in Z_m) log p < (3m-s_2(m)+1/2)log 2"
  }
