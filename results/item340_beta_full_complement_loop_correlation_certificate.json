  "item": 340,
  "proof_object": {
    "actual_target_resonance": "An Item-316 failure has R<a/2, so floor(R/a)=0 and canonical uniqueness makes the returned word and its Lambda identical to the original target word and tower.",
    "complement_height": "For n>=9, 3d<t<4d and b is within constant multiples of A^3 d; thus log t=log b-3 log A+O(1).",
    "dual_inverse": "Euler gives cS=(-1)^(n-3) mod a, hence R S=sigma kappa mod a and the complement-inverse loop returns Rbar=R mod a.",
    "loop_defect_capacity": "0<=floor(R/a)<=A/2, so every nonzero loop defect has only O(log n)=o(log b) prime-power mass.",
    "missing_correlation": "Gamma_Q splits exactly into complement-covered and excess valuation mass. Neither term is bounded; progress requires a joint theorem for target cofactors and canonical complement digits or the bQ quotient lift.",
    "mod_Q_ideal": "For Q|b, after adjoining both the small-error and appended target defects, the ideal with b t_theta-T-epsilon R_delta equals the ideal with a^2-epsilon R_delta; all complement digits disappear from the undivided Q-level incidence.",
    "quotient_bridge": "t=ell mod Q iff T+epsilon R=b ell mod bQ, and v_p(T+epsilon R)=v_p(b)+v_p(t).",
    "returned_dual_coordinates": "The unique dual representative gives Ebar=sigma kappa; the master identity gives Ubar=epsilon a-floor(R/a).",
    "seed_identity": "b t=T+epsilon R, where t=c-kappa and T=bc-a^2."
  },
