  "all_N_theorem_checked_symbolically_in_source": {
    "adjacent_asymptotic_consequences": "liminf (log Q_N+log Q_(N+1))/N>=2 log 3; limsup log Q_N/N>=log 3",
    "adjacent_determinant": "D_N=P_N*Q_(N+1)-P_(N+1)*Q_N>0 and v2(D_N)=1",
    "adjacent_product_floor": "Q_N*Q_(N+1)>(13*pi^2/216)*3^(2N+3)",
    "asymptotic_error": "32/(pi^2*3^(2N+3))*(1+O((3/5)^(2N+1)))",
    "exact_ratio": "P_N/Q_N=(4/pi^2)*beta(2N+3)/beta(2N+1)",
    "lower_error": "alpha*(8/3^(2N+3)-24/5^(2N+3))",
    "upper_error": "alpha*(8/3^(2N+3))/(1-3^(-(2N+1)))"
  },
  "barrier": "The adjacent determinant gives an unconditional exponential floor for Q_N*Q_(N+1), while the pi^2 measure gives an individual log Q_N=Omega(N) floor. Both yield only O(N) improvements in log G_N and do not imply log G_N=o(N log N).",
  "definitions": {
    "A_N": "(2N+2)(2N+1)",
    "G_N": "gcd(A_N*abs(E_2N),abs(E_(2N+2)))",
    "P_N": "abs(E_(2N+2))/G_N",
    "Q_N": "A_N*abs(E_2N)/G_N",
    "alpha": "4/pi^2"
  },
